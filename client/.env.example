# Development: pakai proxy Vite (/api -> http://localhost:3000), tidak perlu diubah
# Production (deploy di Vercel, frontend + backend satu domain):
#   VITE_API_URL=/api  (same-origin, otomatis diarahkan ke serverless function)
#   (opsional: VITE_FRONTEND_URL=https://<nama>.vercel.app — default = origin browser)
VITE_API_URL=/api
